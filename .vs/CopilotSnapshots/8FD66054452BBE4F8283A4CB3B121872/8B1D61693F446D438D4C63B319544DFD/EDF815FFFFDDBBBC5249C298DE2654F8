/* ============================================
   PROFILE PAGE
   ============================================ */

.profile-page {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  padding: 0px 0px 128px;
  position: relative;
  width: 100%;
  max-width: 390px;
  margin: 0 auto;
  min-height: 100vh;
  background: linear-gradient(0deg, #ddffe2, #ddffe2), #ffffff;
}

/* ============================================
   HEADER
   ============================================ */

.profile-page > :first-child {
  flex: none;
  order: 0;
  align-self: stretch;
  flex-grow: 0;
  z-index: 1;
}

/* ============================================
   MAIN CONTENT
   ============================================ */

.profile-content {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  padding: 22px 24px;
  gap: 48px;
  width: 100%;
  max-width: 896px;
  flex: none;
  order: 1;
  align-self: stretch;
  flex-grow: 0;
}

/* ============================================
   USER INFO SECTION
   ============================================ */

.user-info {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  padding: 0;
  gap: 24px;
  width: 100%;
  max-width: 334px;
}

.user-avatar {
  display: flex;
  flex-direction: row;
  justify-content: center;
  align-items: center;
  width: 128px;
  height: 128px;
  background: #acecbb;
  border-radius: 9999px;
}

.user-info h1 {
  font-family: 'Plus Jakarta Sans';
  font-size: 36px;
  font-weight: 800;
  line-height: 40px;
  letter-spacing: -0.9px;
  color: #0b361d;
  margin: 0;
}

.user-info .subtitle {
  font-family: 'Plus Jakarta Sans';
  font-size: 18px;
  font-weight: 400;
  line-height: 28px;
  color: rgba(11, 54, 29, 0.7);
  margin: 0;
}

.stats-container {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: flex-end;
  padding: 0;
  gap: 16px;
  width: 100%;
  height: auto;
  position: relative;
}

.stat-card {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  padding: 0;
  flex: 1;
  height: 152px;
  background: #cafdd4;
  border-radius: 48px;
  position: relative;
  overflow: hidden;
}

.stat-card::before {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: linear-gradient(135deg, rgba(157, 241, 151, 0.3) 0%, rgba(157, 241, 151, 0) 100%);
  z-index: 0;
}

.stat-card::after {
  content: '';
  position: absolute;
  width: 192px;
  height: 160px;
  right: -40px;
  bottom: -40px;
  background: #176a21;
  opacity: 0.2;
  z-index: 0;
}

.stat-value {
  font-family: 'Plus Jakarta Sans';
  font-size: 36px;
  font-weight: 700;
  line-height: 48px;
  text-align: center;
  color: #176a21;
  margin: 0;
  position: relative;
  z-index: 2;
}

.stat-label {
  font-family: 'Plus Jakarta Sans';
  font-size: 12px;
  font-weight: 700;
  line-height: 20px;
  text-align: center;
  letter-spacing: 1.4px;
  text-transform: uppercase;
  color: #3b6447;
  margin: 8px 0 0 0;
  position: relative;
  z-index: 2;
}

/* ============================================
   SETTINGS SECTION
   ============================================ */

.settings {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  padding: 0;
  gap: 40px;
  width: 100%;
  max-width: 334px;
}

.settings h2 {
  font-family: 'Plus Jakarta Sans';
  font-size: 48px;
  font-weight: 700;
  line-height: 56px;
  letter-spacing: -1.4px;
  color: #0b361d;
  margin: 0;
}

.setting-item {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  padding: 0;
  width: 100%;
  max-width: 302px;
  background: none;
  border: none;
  cursor: pointer;
  transition: all 0.2s ease;
}

.setting-item:hover {
  opacity: 0.7;
}

.setting-left {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 24px;
  flex: 1;
}

.setting-left svg {
  width: 20px;
  height: 20px;
  color: #176a21;
  flex-shrink: 0;
}

.setting-left span {
  font-family: 'Plus Jakarta Sans';
  font-size: 18px;
  font-weight: 500;
  line-height: 27px;
  letter-spacing: 0.45px;
  color: #0b361d;
}

.setting-value {
  font-family: 'Plus Jakarta Sans';
  font-size: 14px;
  font-weight: 600;
  line-height: 21px;
  letter-spacing: 1.4px;
  text-transform: uppercase;
  color: #246830;
}

/* Toggle Switch */

.toggle {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 4px;
  width: 56px;
  height: 32px;
  background: #acecbb;
  border-radius: 9999px;
  transition: all 0.3s ease;
}

.toggle.on {
  background: #176a21;
}

.toggle-circle {
  width: 24px;
  height: 24px;
  background: #ddffe2;
  border-radius: 9999px;
  box-shadow: 0px 4px 12px rgba(11, 54, 29, 0.1);
  transition: all 0.3s ease;
}

.toggle.on .toggle-circle {
  margin-left: auto;
  background: #ffffff;
}

/* ============================================
   LOGOUT BUTTON
   ============================================ */

.logout-link {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 24px;
  padding: 0;
  width: 100%;
  max-width: 302px;
  height: 27px;
  background: none;
  border: none;
  cursor: pointer;
  margin-top: 48px;
  transition: all 0.2s ease;
}

.logout-link:hover {
  opacity: 0.7;
}

.logout-link svg {
  width: 20px;
  height: 20px;
  color: #b02500;
  flex-shrink: 0;
}

.logout-link span {
  font-family: 'Plus Jakarta Sans';
  font-size: 18px;
  font-weight: 600;
  line-height: 27px;
  letter-spacing: 0.45px;
  color: #b02500;
}

/* ============================================
   BOTTOM NAV
   ============================================ */

.profile-page > :last-child {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 2;
  max-width: 390px;
  margin: 0 auto;
  width: 100%;
}

/* ============================================
   RESPONSIVE
   ============================================ */

@media (max-width: 640px) {
  .profile-content {
    padding: 16px 16px;
    gap: 32px;
  }

  .settings {
    padding: 0;
  }

  .settings h2 {
    font-size: 36px;
    line-height: 44px;
  }
}