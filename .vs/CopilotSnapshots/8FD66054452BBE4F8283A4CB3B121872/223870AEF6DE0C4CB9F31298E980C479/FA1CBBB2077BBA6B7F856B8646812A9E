/* ============================================
   PORTFEL PAGE - Responsive Layout
   ============================================ */

.portfel-page {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  padding: 0px 0px 128px;
  width: 100%;
  max-width: 390px;
  margin: 0 auto;
  min-height: 100vh;
  background: linear-gradient(0deg, #ddffe2, #ddffe2), #ffffff;
  position: relative;
}

/* ============================================
   HEADER
   ============================================ */

.portfel-page > :first-child {
  flex: none;
  order: 1;
  align-self: stretch;
  z-index: 1;
}

/* ============================================
   MAIN CONTENT
   ============================================ */

.portfel-main-content {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  padding: 32px 24px;
  gap: 21px;
  width: 100%;
  max-width: 768px;
  flex: none;
  order: 2;
  align-self: stretch;
  flex-grow: 0;
  z-index: 0;
}

/* ============================================
   BALANCE SECTION
   ============================================ */

.balance-section {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  padding: 32px;
  gap: 24px;
  isolation: isolate;
  width: 100%;
  max-width: 342px;
  height: auto;
  background: #ffffff;
  box-shadow: 0px 12px 32px -4px rgba(11, 54, 29, 0.06);
  border-radius: 48px;
  position: relative;
}

.balance-section::before {
  content: "Z";
  position: absolute;
  right: -48.01px;
  top: -48px;
  width: 109px;
  height: 192px;
  font-family: 'Plus Jakarta Sans';
  font-size: 192px;
  font-weight: 800;
  line-height: 192px;
  color: #176a21;
  opacity: 0.05;
}

.balance-header {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 8px;
  width: 100%;
  position: relative;
  z-index: 1;
}

.balance-label {
  font-family: 'Plus Jakarta Sans';
  font-size: 16px;
  font-weight: 400;
  line-height: 24px;
  letter-spacing: 1.6px;
  text-transform: uppercase;
  color: #3b6447;
  margin: 0;
}

.balance-amount {
  font-family: 'Plus Jakarta Sans';
  font-size: 48px;
  font-weight: 800;
  line-height: 48px;
  letter-spacing: -2.4px;
  color: #0b361d;
  margin: 0;
}

.balance-amount .currency {
  font-size: 20px;
  font-weight: 700;
  margin-left: 8px;
  color: #176a21;
}

.primary-button {
  display: flex;
  flex-direction: row;
  justify-content: center;
  align-items: center;
  gap: 7.62px;
  padding: 15.24px 0;
  width: 100%;
  max-width: 262px;
  height: 53.35px;
  background: linear-gradient(90deg, #176a21 0%, #025d16 100%);
  border: none;
  border-radius: 9999px;
  box-shadow: 0px 7.62px 22.87px -3.81px rgba(23, 106, 33, 0.25);
  font-family: 'Plus Jakarta Sans';
  font-size: 15.24px;
  font-weight: 700;
  line-height: 23px;
  color: #d1ffc8;
  cursor: pointer;
  transition: all 0.3s ease;
  position: relative;
  z-index: 2;
}

.primary-button:hover {
  transform: translateY(-2px);
  box-shadow: 0px 10px 28px -2px rgba(23, 106, 33, 0.3);
}

.primary-button span {
  font-size: 18px;
}

/* ============================================
   COUPONS SECTION
   ============================================ */

.coupons-section {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  padding: 0;
  gap: 12px;
  width: 100%;
  max-width: 342px;
}

.section-header {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: flex-end;
  width: 100%;
}

.section-title {
  font-family: 'Plus Jakarta Sans';
  font-size: 24px;
  font-weight: 700;
  line-height: 32px;
  color: #0b361d;
  margin: 0;
}

.section-subtitle {
  font-family: 'Plus Jakarta Sans';
  font-size: 14px;
  font-weight: 600;
  line-height: 20px;
  color: #176a21;
  margin: 0;
}

.coupons-gallery {
  display: flex;
  flex-direction: row;
  justify-content: center;
  align-items: center;
  gap: 20px;
  padding: 8px;
  width: 100%;
  max-width: 326px;
  max-height: 150px;
  overflow-x: auto;
  scroll-behavior: smooth;
}

.coupon-card {
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20px 25px;
  gap: 10px;
  isolation: isolate;
  flex-shrink: 0;
  width: 140px;
  height: 150px;
  background: #ffffff;
  border: 1px solid rgba(139, 183, 149, 0.15);
  border-radius: 48px;
  box-shadow: 0px 8px 24px -4px rgba(11, 54, 29, 0.04);
  position: relative;
}

.coupon-icon {
  display: flex;
  flex-direction: row;
  justify-content: center;
  align-items: center;
  width: 64px;
  height: 64px;
  background: #abf4ac;
  border-radius: 9999px;
  font-size: 32px;
  line-height: 1;
}

.coupon-info {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 4px;
  width: 100%;
}

.coupon-name {
  font-family: 'Plus Jakarta Sans';
  font-size: 16px;
  font-weight: 700;
  line-height: 24px;
  color: #0b361d;
  text-align: center;
  width: 100%;
  margin: 0;
}

.coupon-price {
  font-family: 'Plus Jakarta Sans';
  font-size: 12px;
  font-weight: 400;
  line-height: 16px;
  color: #3b6447;
  text-align: center;
  width: 100%;
  margin: 0;
}

.pagination-dots {
  display: flex;
  flex-direction: row;
  justify-content: center;
  align-items: center;
  gap: 5px;
  padding: 1px 0;
  width: 100%;
  max-width: 326px;
}

.dot {
  width: 7px;
  height: 7px;
  background: #8dd09c;
  border-radius: 50%;
  cursor: pointer;
  transition: all 0.3s ease;
}

.dot.active {
  width: 11px;
  height: 11px;
  background: #176a21;
}

/* ============================================
   TRANSACTIONS SECTION
   ============================================ */

.transactions-section {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  padding: 0;
  gap: 24px;
  width: 100%;
  max-width: 342px;
}

.transactions-list {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 24px;
  width: 100%;
}

.transaction-item {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  padding: 0;
  gap: 116.46px;
  width: 100%;
  max-width: 342px;
  height: auto;
}

.transaction-left {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16px;
}

.transaction-icon {
  display: flex;
  flex-direction: row;
  justify-content: center;
  align-items: center;
  width: 48px;
  height: 48px;
  background: #acecbb;
  border-radius: 9999px;
  flex-shrink: 0;
}

.transaction-icon::before {
  content: '';
  width: 19px;
  height: 20px;
  background: #176a21;
}

.transaction-info {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 0;
}

.transaction-type {
  font-family: 'Plus Jakarta Sans';
  font-size: 16px;
  font-weight: 700;
  line-height: 24px;
  color: #0b361d;
  margin: 0 0 4px 0;
}

.transaction-location {
  font-family: 'Plus Jakarta Sans';
  font-size: 14px;
  font-weight: 400;
  line-height: 20px;
  color: #3b6447;
  margin: 0;
}

.transaction-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 0;
}

.transaction-amount {
  font-family: 'Plus Jakarta Sans';
  font-size: 16px;
  font-weight: 700;
  line-height: 24px;
  color: #176a21;
  text-align: right;
  margin: 0 0 4px 0;
}

.transaction-date {
  font-family: 'Plus Jakarta Sans';
  font-size: 12px;
  font-weight: 400;
  line-height: 16px;
  color: #3b6447;
  text-align: right;
  margin: 0;
}

/* ============================================
   BOTTOM NAV
   ============================================ */

.portfel-page > :last-child {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 2;
  max-width: 390px;
  margin: 0 auto;
  width: 100%;
}

/* ============================================
   RESPONSIVE
   ============================================ */

@media (max-width: 640px) {
  .portfel-main-content {
    padding: 24px 16px;
    gap: 16px;
  }

  .balance-section {
    padding: 24px;
  }

  .transaction-item {
    gap: 80px;
  }

  .coupons-gallery {
    max-height: 120px;
  }
}
